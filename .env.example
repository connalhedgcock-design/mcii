# Copy to app/.env and fill in. Never commit the real file.
TWITTERAPI_KEY=your_key_here
X_MONTHLY_CAP_USD=24

# Lets the app push its holdings to the Telegram alerter's KV store, so the offline liquidity-pull
# alerts know what is actually held. Create at dash.cloudflare.com/profile/api-tokens with the
# single permission Account -> Workers KV Storage -> Edit. Optional: without it the app just skips
# the push. See cloudflare/telegram-alerts/README.md.
CLOUDFLARE_KV_TOKEN=your_token_here
